<?xml version="1.0" encoding="utf-8"?>
<!-- Today beside Coming up: one drawing (light and dark twins, TodayWidgets.wide), and clear halves over it for
     the taps, Today to Log and Coming up to Upcoming. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <ImageView
        android:id="@+id/widget_words"
        android:visibility="@integer/widget_light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_coming_up_description"
        android:scaleType="fitStart"
        android:src="@drawable/widget_preview_words" />

    <ImageView
        android:id="@+id/widget_words_dark"
        android:visibility="@integer/widget_dark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_coming_up_description"
        android:scaleType="fitStart"
        android:src="@drawable/widget_preview_words" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_tap_today"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/what_changed" />

            <ImageView
                android:id="@+id/widget_tap_soon"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/coming_up" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
