<?xml version="1.0" encoding="utf-8"?>
<!-- Today, as the iPhone app's widget: the words are drawn into the image in Release Notes' fonts
     (TodayWidgets in VersionWidget.kt), since a widget can't use an app's own. Also the picker's preview. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <ImageView
        android:id="@+id/widget_words"
        android:visibility="@integer/widget_light"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_description"
        android:scaleType="fitStart"
        android:src="@drawable/widget_preview_words" />
    <ImageView
        android:id="@+id/widget_words_dark"
        android:visibility="@integer/widget_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_description"
        android:scaleType="fitStart"
        android:src="@drawable/widget_preview_words" />
</FrameLayout>
